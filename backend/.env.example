# Copy to backend/.env and fill in. Only the key for LLM_PROVIDER is required.

# anthropic | openai
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=your-anthropic-key
OPENAI_API_KEY=

# Models (optional, defaults shown)
ANTHROPIC_FAST_MODEL=claude-haiku-5-5
ANTHROPIC_STRONG_MODEL=claude-sonnet-5-5
OPENAI_MODEL=gpt-4.1-mini

# LLM call reliability (optional, defaults shown)
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
LLM_MAX_TOKENS=2000

# App (optional, defaults shown). CORS_ORIGINS is a JSON list.
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]
