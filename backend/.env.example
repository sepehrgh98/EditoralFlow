# Copy to backend/.env and fill in. All values are optional; defaults shown.

# ollama (free, runs on your machine) | anthropic (Claude API, paid per use)
LLM_PROVIDER=ollama

# --- Ollama (local) ---
# Install from https://ollama.com, then: ollama pull qwen3:8b
OLLAMA_HOST=http://localhost:11434
OLLAMA_FAST_MODEL=qwen3:8b
OLLAMA_STRONG_MODEL=qwen3:14b
OLLAMA_NUM_CTX=16384
OLLAMA_THINK=false

# --- Anthropic (Claude API) ---
# Only needed when LLM_PROVIDER=anthropic. API keys come from console.anthropic.com
# and are billed separately from a claude.ai Pro subscription.
ANTHROPIC_API_KEY=
ANTHROPIC_FAST_MODEL=claude-haiku-5-5
ANTHROPIC_STRONG_MODEL=claude-sonnet-5-5

# --- LLM call reliability ---
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3
LLM_MAX_TOKENS=16000

# --- App --- (CORS_ORIGINS is a JSON list)
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]
